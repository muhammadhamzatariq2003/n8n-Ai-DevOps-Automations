    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "84a93f2a-fe31-4000-8000-2be9e2efb228",
              "name": "slackChannel",
              "value": "engineering-alerts",
              "type": "string"
            },
            {
              "id": "3bca72bf-6415-4000-8000-ca3800070f7c",
              "name": "allowedRepos",
              "value": "",
