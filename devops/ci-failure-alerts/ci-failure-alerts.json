            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "f32fc882-5b20-4000-8000-70bfa26480ce",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $input.item.json;\nconst body = j.body || {};\nconst event = (j.headers || {})['x-github-event'];\nconst esc = (s) => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst run = body.workflow_run;\nconst repo = body.repository && body.repository.full_name;\nconst allowed = String(j.allowedRepos || '').split(',').map((s) => s.trim().toLowerCase()).filter(Boolean);\n\nconst failed = run && ['failure', 'timed_out'].includes(run.conclusion);\nif (event !== 'workflow_run' || body.action !== 'completed' || !failed || !repo\n    || (allowed.length && !allowed.includes(repo.toLowerCase()))) {\n  return { json: { send: false } };\n}\n\nconst commit = run.head_commit || {};\nconst firstLine = String(commit.message || '').split('\\n')[0];\nconst actor = (run.triggering_actor && run.triggering_actor.login) || (run.actor && run.actor.login) || 'unknown';\n\nconst text = [\n  run.conclusion === 'timed_out' ? '🟠 *CI timed out*' : '🔴 *CI failure*',\n  `*Workflow:* ${esc(run.name)}`,\n  `*Repo:* ${esc(repo)}   *Branch:* \\`${esc(run.head_branch)}\\``,\n  `*Commit:* \\`${String(run.head_sha || '').slice(0, 7)}\\` — ${esc(firstLine)}`,\n  `*Triggered by:* ${esc(actor)}${run.run_attempt > 1 ? ` (attempt ${run.run_attempt})` : ''}`,\n  `<${run.html_url}|View run>`,\n].join('\\n');\n\nreturn { json: { send: true, channel: j.slackChannel || 'engineering-alerts', text } };",
        "mode": "runOnceForEachItem"
      },
      "id": "3f82ad29-b436-4000-8000-4cba4fe1d1e8",
      "name": "Prepare Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
