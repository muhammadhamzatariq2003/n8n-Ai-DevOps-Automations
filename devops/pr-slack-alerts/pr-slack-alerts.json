        "options": {}
      },
      "id": "f4b06489-eafa-4000-8000-c3d6516617db",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $input.item.json;\nconst body = j.body || {};\nconst event = (j.headers || {})['x-github-event'];\nconst esc = (s) => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst allowed = String(j.allowedRepos || '').split(',').map((s) => s.trim().toLowerCase()).filter(Boolean);\nconst repo = body.repository && body.repository.full_name;\nif (event !== 'pull_request' || !body.pull_request || !repo\n    || (allowed.length && !allowed.includes(repo.toLowerCase()))) {\n  return { json: { send: false } };\n}\n\nconst pr = body.pull_request;\nconst title = `*<${pr.html_url}|${esc(pr.title)}>*`;\nlet text = null;\n\nif (body.action === 'opened' || body.action === 'ready_for_review') {\n  text = [\n    pr.draft ? '↗ *New draft PR*' : '↗ *New PR opened*',\n    title,\n    `By ${esc(pr.user && pr.user.login)} in ${esc(repo)}`,\n    `+${pr.additions} / -${pr.deletions} lines in ${pr.changed_files} file${pr.changed_files === 1 ? '' : 's'}`,\n  ].join('\\n');\n} else if (body.action === 'closed' && pr.merged === true) {\n  text = [\n    '🔀 *PR merged*',\n    title,\n    `Merged by ${esc((pr.merged_by && pr.merged_by.login) || (body.sender && body.sender.login))} into \\`${esc(pr.base && pr.base.ref)}\\``,\n    `Repo: ${esc(repo)}`,\n  ].join('\\n');\n}\n\nreturn { json: { send: text !== null, channel: j.slackChannel || 'engineering', text } };",
        "mode": "runOnceForEachItem"
      },
      "id": "0a77cb15-c597-4000-8000-130c80ae43f2",
      "name": "Prepare Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
