            },
            {
              "id": "e4054109-95b6-4000-8000-a11a552d5c49",
              "name": "allowedLabels",
              "value": "bug, enhancement, documentation, question, performance, security, good first issue, help wanted, duplicate, wontfix",
              "type": "string"
            },
