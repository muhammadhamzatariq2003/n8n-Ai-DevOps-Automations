        }
      },
      "id": "4326608b-c514-4000-8000-2bea7a6156f4",
      "name": "Classify with OpenAI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        300
      ],
      "credentials": {
        "openAiApi": {
          "id": "2",
          "name": "OpenAI Account"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const TOPICS = ['technology', 'science', 'business', 'politics', 'sports', 'entertainment', 'health', 'education', 'lifestyle', 'other'];\nconst SENTIMENTS = ['positive', 'neutral', 'negative', 'mixed'];\n\nconst input = $('Validate Input').item.json;\nconst raw = (((($input.item.json.choices || [])[0] || {}).message || {}).content) || '{}';\n\nlet r = {};\ntry { r = JSON.parse(raw); } catch (e) { r = {}; }\n\nconst topic = String(r.topic || '').toLowerCase();\nconst sentiment = String(r.sentiment || '').toLowerCase();\nlet confidence = Number(r.confidence);\nif (!Number.isFinite(confidence)) confidence = 0;\nconfidence = Math.min(1, Math.max(0, Math.round(confidence * 100) / 100));\n\nreturn { json: {\n  success: true,\n  data: {\n    classification: {\n      topic: TOPICS.includes(topic) ? topic : 'other',\n      sentiment: SENTIMENTS.includes(sentiment) ? sentiment : 'neutral',\n      confidence,\n      summary: typeof r.summary === 'string' ? r.summary.trim().slice(0, 300) : '',\n    },\n    inputText: input.text,\n    processedAt: new Date().toISOString(),\n  },\n} };",
        "mode": "runOnceForEachItem"
      },
      "id": "350c3e9c-3d61-4000-8000-1debe53d6174",
      "name": "Parse Classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
